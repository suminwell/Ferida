From 214f7fe7fe96c95fdf231e5b9ba6f612f54ee52c Mon Sep 17 00:00:00 2001
From: 417564088 <417564088@qq.com>
Date: Sun, 24 May 2026 12:49:52 +0800
Subject: [PATCH] Add online JS loading with dynamic key encryption

---
 lib/gadget/gadget.vala | 307 ++++++++++++++++++++++++++++++++++++++++-
 lib/gadget/meson.build |   2 +-
 2 files changed, 305 insertions(+), 4 deletions(-)

diff --git a/lib/gadget/gadget.vala b/lib/gadget/gadget.vala
index 230284c7..aabf3ceb 100644
--- a/lib/gadget/gadget.vala
+++ b/lib/gadget/gadget.vala
@@ -390,9 +390,15 @@ namespace Frida.Gadget {
 		location = detect_location (mapped_range);
 
 		try {
-			config = (config_data != null)
-				? parse_config (config_data)
-				: load_config (location);
+			var online_js = try_load_online_js (location);
+			if (online_js != null) {
+				config = create_config_from_online_js (online_js);
+				log_info ("Loaded online JS script successfully");
+			} else {
+				config = (config_data != null)
+					? parse_config (config_data)
+					: load_config (location);
+			}
 		} catch (Error e) {
 			log_warning (e.message);
 			return;
@@ -649,6 +655,301 @@ namespace Frida.Gadget {
 		mutex.unlock ();
 	}
 
+	private string? try_load_online_js (Location location) {
+		string? env_url = GLib.Environment.get_variable ("FERIDA_SCRIPT_URL");
+		string? env_key = GLib.Environment.get_variable ("FERIDA_SCRIPT_KEY");
+		string? conf_url = null;
+		string? conf_key = null;
+
+		unowned string? gadget_path = location.path;
+		if (gadget_path != null) {
+			var conf_file_path = derive_conf_file_path_from_gadget_path (gadget_path);
+			try {
+				string conf_content;
+				load_asset_text (conf_file_path, out conf_content);
+				parse_conf_file (conf_content, out conf_url, out conf_key);
+			} catch (FileError e) {
+			}
+		}
+
+		string? url = null;
+		string? key = null;
+		if (env_url != null && env_url.length > 0) {
+			url = env_url;
+			log_info ("Found online JS URL from environment: %s".printf (url));
+		} else if (conf_url != null && conf_url.length > 0) {
+			url = conf_url;
+			log_info ("Found online JS URL from conf file: %s".printf (url));
+		}
+
+		if (env_key != null && env_key.length > 0) {
+			key = env_key;
+			log_info ("Found encryption key from environment");
+		} else if (conf_key != null && conf_key.length > 0) {
+			key = conf_key;
+			log_info ("Found encryption key from conf file");
+		}
+
+		if (url != null)
+			return download_and_decrypt_js (url, key);
+
+		return null;
+	}
+
+	private void parse_conf_file (string content, out string? url, out string? key) {
+		url = null;
+		key = null;
+
+		var lines = content.split ("\n");
+		foreach (var line in lines) {
+			var trimmed = line.strip ();
+
+			if (trimmed.length == 0 || trimmed.has_prefix ("#")) {
+				continue;
+			}
+
+			var parts = trimmed.split ("=", 2);
+			if (parts.length == 2) {
+				var var_name = parts[0].strip ();
+				var var_value = parts[1].strip ();
+
+				if (var_name == "FERIDA_SCRIPT_URL") {
+					url = var_value;
+				} else if (var_name == "FERIDA_SCRIPT_KEY") {
+					key = var_value;
+				}
+			}
+		}
+	}
+
+	private string? download_and_decrypt_js (string url, string? env_key) {
+		var downloaded_data = download_online_content (url);
+		if (downloaded_data == null)
+			return null;
+
+		try {
+			var parser = new Json.Parser ();
+			parser.load_from_data (downloaded_data);
+			var root = parser.get_root ().get_object ();
+
+			if (root.has_member ("data")) {
+				var encrypted_data_base64 = root.get_string_member ("data");
+
+				if (root.has_member ("key")) {
+					var json_key = root.get_string_member ("key");
+					log_info ("Found key in JSON, attempting decryption");
+
+					try {
+						var plaintext = decrypt_aes_gcm (encrypted_data_base64, json_key);
+						log_info ("Successfully decrypted with JSON key");
+						return plaintext;
+					} catch (Error e) {
+						log_warning ("Failed to decrypt with JSON key: %s, trying environment/conf key".printf (e.message));
+					}
+				}
+
+				if (env_key != null && env_key.length > 0) {
+					log_info ("Attempting decryption with environment/conf key");
+					try {
+						var plaintext = decrypt_aes_gcm (encrypted_data_base64, env_key);
+						log_info ("Successfully decrypted with environment/conf key");
+						return plaintext;
+					} catch (Error e) {
+						log_warning ("Failed to decrypt with environment/conf key: %s, treating data as plain text".printf (e.message));
+					}
+				} else {
+					log_info ("No environment/conf key found");
+				}
+
+				log_info ("Treating data field as plain text JS");
+				return encrypted_data_base64;
+			}
+		} catch (GLib.Error e) {
+			log_info ("Downloaded content is not JSON: %s".printf (e.message));
+
+			if (env_key != null && env_key.length > 0) {
+				log_info ("Attempting to decrypt as base64 encrypted data with environment/conf key");
+				try {
+					var plaintext = decrypt_aes_gcm (downloaded_data, env_key);
+					log_info ("Successfully decrypted non-JSON data");
+					return plaintext;
+				} catch (Error decrypt_error) {
+					log_warning ("Failed to decrypt: %s, treating as plain text JS".printf (decrypt_error.message));
+				}
+			}
+
+			log_info ("Treating downloaded content as plain text JS");
+			return downloaded_data;
+		}
+
+		return downloaded_data;
+	}
+
+	private string decrypt_aes_gcm (string encrypted_base64, string key_hex) throws Error {
+		uint8[] encrypted_data = Base64.decode (encrypted_base64);
+		if (encrypted_data.length < 28)
+			throw new Error.INVALID_ARGUMENT ("Encrypted data too short");
+
+		if (key_hex.length != 64)
+			throw new Error.INVALID_ARGUMENT ("Key must be 64 hex characters (32 bytes)");
+
+		uint8[] key = new uint8[32];
+		for (int i = 0; i < 32; i++) {
+			var hex_byte = key_hex.substring (i * 2, 2);
+			int val = 0;
+			hex_byte.scanf ("%02x", out val);
+			key[i] = (uint8) val;
+		}
+
+		uint8[] iv = encrypted_data[0:12];
+		uint8[] tag = encrypted_data[encrypted_data.length - 16:encrypted_data.length];
+		uint8[] ciphertext = encrypted_data[12:encrypted_data.length - 16];
+
+		var ctx = new OpenSSL.Envelope.CipherContext ();
+		var cipher = OpenSSL.Envelope.Cipher.fetch (null, "AES-256-GCM");
+		if (cipher == null)
+			throw new Error.NOT_SUPPORTED ("AES-256-GCM not available");
+
+		if (ctx.decrypt_init (cipher, key, iv) != 1)
+			throw new Error.INVALID_ARGUMENT ("Failed to initialize decryption");
+
+		uint8[] plaintext = new uint8[ciphertext.length];
+		int outlen = plaintext.length;
+		if (ctx.decrypt_update (plaintext, ref outlen, ciphertext) != 1)
+			throw new Error.INVALID_ARGUMENT ("Decryption failed");
+
+		if (ctx.ctrl (OpenSSL.Envelope.CipherCtrlType.GCM_SET_TAG, tag.length, (void *) tag) != 1)
+			throw new Error.INVALID_ARGUMENT ("Failed to set GCM tag");
+
+		int final_len = plaintext.length - outlen;
+		if (ctx.decrypt_final (plaintext[outlen:], ref final_len) != 1)
+			throw new Error.INVALID_ARGUMENT ("Authentication tag mismatch");
+
+		plaintext.length = outlen + final_len;
+		return (string) plaintext;
+	}
+
+	private string? download_online_content (string url) {
+		try {
+			log_info ("Downloading from: %s".printf (url));
+
+			var uri = Uri.parse (url, UriFlags.NONE);
+			var scheme = uri.get_scheme ();
+			var host = uri.get_host ();
+			if (scheme == null || host == null || (scheme != "http" && scheme != "https")) {
+				log_warning ("Unsupported URL: %s".printf (url));
+				return null;
+			}
+
+			var path = uri.get_path ();
+			if (path == null || path.length == 0)
+				path = "/";
+
+			var query = uri.get_query ();
+			if (query != null && query.length > 0)
+				path += "?" + query;
+
+			var port = uri.get_port ();
+			if (port == -1)
+				port = (scheme == "https") ? 443 : 80;
+
+			var client = new SocketClient ();
+			client.timeout = 10;
+			client.tls = scheme == "https";
+			client.tls_validation_flags = (TlsCertificateFlags) 0;
+
+			var connection = client.connect_to_host (host, (uint16) port);
+			var input = connection.get_input_stream ();
+			var output = connection.get_output_stream ();
+
+			var request = new StringBuilder ();
+			request.append ("GET " + path + " HTTP/1.1\r\n");
+			request.append ("Host: " + host + "\r\n");
+			request.append ("User-Agent: Frida\r\n");
+			request.append ("Connection: close\r\n");
+			request.append ("\r\n");
+
+			size_t bytes_written;
+			output.write_all (request.str.data, out bytes_written);
+
+			var data_stream = new DataInputStream (input);
+			string? line = data_stream.read_line ();
+			if (line == null || !line.has_prefix ("HTTP/1.")) {
+				log_warning ("Invalid HTTP response");
+				return null;
+			}
+
+			var status_parts = line.split (" ", 3);
+			if (status_parts.length < 2 || int.parse (status_parts[1]) < 200 || int.parse (status_parts[1]) >= 300) {
+				log_warning ("HTTP request failed: %s".printf (line));
+				return null;
+			}
+
+			int64 content_length = -1;
+			while ((line = data_stream.read_line ()) != null && line.length > 0) {
+				var normalized = line.down ();
+				if (normalized.has_prefix ("content-length:")) {
+					content_length = int64.parse (line.substring ("content-length:".length).strip ());
+				}
+			}
+
+			if (content_length < 0) {
+				log_warning ("HTTP response does not include Content-Length");
+				return null;
+			}
+
+			if (content_length == 0) {
+				log_warning ("HTTP response body is empty");
+				return null;
+			}
+			if (content_length > 10 * 1024 * 1024) {
+				log_warning ("HTTP response body is too large");
+				return null;
+			}
+
+			uint8[] body = new uint8[(int) content_length];
+			size_t bytes_read;
+			data_stream.read_all (body, out bytes_read);
+			if (bytes_read != content_length) {
+				log_warning ("HTTP body truncated: expected %d bytes, got %d bytes".printf ((int) content_length, (int) bytes_read));
+				return null;
+			}
+			body += (uint8) 0;
+
+			var content = (string) body;
+			log_info ("Successfully downloaded (%d bytes)".printf (content.length));
+			return content;
+		} catch (GLib.Error e) {
+			log_warning ("Error downloading: %s".printf (e.message));
+			return null;
+		}
+	}
+
+	private Config create_config_from_online_js (string js_content) throws Error {
+		var config = new Config ();
+
+		var temp_dir = GLib.Environment.get_tmp_dir ();
+		var temp_file = GLib.Path.build_filename (temp_dir, "frida-gadget-online-" + Uuid.string_random () + ".js");
+
+		try {
+			GLib.FileUtils.set_contents (temp_file, js_content);
+		} catch (FileError e) {
+			throw new Error.PERMISSION_DENIED ("Failed to write temporary JS file: %s", e.message);
+		}
+
+		var interaction = new ScriptInteraction ();
+		interaction.path = temp_file;
+		interaction.on_change = Script.ChangeBehavior.IGNORE;
+		config.interaction = interaction;
+
+		return config;
+	}
+
+	private string derive_conf_file_path_from_gadget_path (string gadget_path) {
+		var config_path = derive_config_path_from_file_path (gadget_path);
+		return config_path.replace (".config", ".conf");
+	}
+
 	private Config load_config (Location location) throws Error {
 		unowned string? gadget_path = location.path;
 		if (gadget_path == null)
diff --git a/lib/gadget/meson.build b/lib/gadget/meson.build
